  "residence": "公寓一樓",
  "personality_short": "說話直接不拐彎，做事謹慎，對朋友可靠但交友圈小。",
  "personality": "Claire不喜歡說話繞圈子，有什麼想法會直接說出來。做決定前會仔細考慮，一旦認定某件事就很難改變看法。交友不多，但對在乎的人很忠誠可靠。對自己的感情不太擅長處理，知道自己喜歡Emma但一直找不到開口的時機。",
  "habit": "Claire上下班時間固定，偶爾加班。喜歡在外面吃飯，不愛自己煮。休假時會獨自去公園散步整理思緒。偶爾去咖啡廳坐坐。",
  "relationships": {
    "A": {
      "initial": "普通朋友，Claire偶爾去咖啡廳時會跟Amy聊天。Claire對Amy沒有特別的感情，只是習慣去那家咖啡廳。",
      "summary": "兩人關係維持原狀。"
    },
    "B": {
      "initial": "普通朋友，Claire和Ben偶爾聚餐，話題輕鬆，相處沒有壓力。",
      "summary": "兩人關係維持原狀。"
    },
    "D": {
      "initial": "David是Claire的上司。Claire對David尊重但不拘謹，有時說話太直接會讓David無奈，但Claire並非故意。",
      "summary": "兩人關係維持原狀。"
    },
    "E": {
      "initial": "Claire喜歡Emma，兩人互相吸引但誰都沒有先開口。Claire知道自己的感覺，但一直在等一個合適的時機。",
      "summary": "兩人關係維持原狀。"
    }
  },
